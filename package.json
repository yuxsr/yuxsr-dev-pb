{
  "name": "yuxsr-dev-pb",
  "version": "0.3.1",
  "description": "yuxsr-dev の各サービスが共有する Protocol Buffers 定義と生成コード",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yushi-a/yuxsr-dev-pb.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./proto/*": "./proto/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "gen/ts",
    "proto"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate": "./generate.sh",
    "compile": "tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "lint": "buf lint",
    "format": "buf format -w",
    "format:check": "buf format --diff --exit-code",
    "test": "npm run compile && npm run typecheck && node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.13.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^2.14.1",
    "@connectrpc/connect": "^2.1.2",
    "typescript": "^7.0.2"
  }
}
